BUN_TARGET=bun-linux-x64

# gRPC
GRPC_PORT=5001

# GraphQL
GRAPHQL_PORT=4001

# Database (Vault-backed at runtime — see packages/server/CLAUDE.md's Database section).
# DATABASE_URL is still required by prisma.config.ts for Prisma CLI operations (generate/migrate),
# which need a static connection regardless of Vault — it's the same superuser scaffolded for
# test1-db, and also the value to pass into `new PgAdapter(process.env.DATABASE_URL!)` for the
# manual "switch to root for testing" override in src/app.ts.
DATABASE_URL=postgresql://myuser:mypassword@localhost:5101/test1
DB_HOST=localhost
DB_PORT=5101
DB_NAME=test1
VAULT_ADDR=http://localhost:8200
VAULT_DB_ROLE=test1-role

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=test1

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081
