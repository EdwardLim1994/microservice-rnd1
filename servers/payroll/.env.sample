BUN_TARGET=bun-linux-x64

# gRPC
GRPC_PORT=5002

# GraphQL
GRAPHQL_PORT=4002

# Database (Vault-backed at runtime — see packages/server/CLAUDE.md's Database section).
# DATABASE_URL is still required by prisma.config.ts for Prisma CLI operations.
DATABASE_URL=postgresql://myuser:mypassword@localhost:5102/payroll
DB_HOST=localhost
DB_PORT=5102
DB_NAME=payroll
VAULT_ADDR=http://localhost:8200
VAULT_DB_ROLE=payroll-role
