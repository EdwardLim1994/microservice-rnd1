{
  "name": "payroll",
  "module": "index.ts",
  "type": "module",
  "version": "0.1.0-rc1",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@bufbuild/buf": "^1.70.0",
    "protoc": "^35.1.0",
    "@graphql-codegen/add": "^7.0.1",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/schema-ast": "^6.0.1",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "prisma": "^7.8.0",
    "@rstest/core": "^0.10.6",
    "@rstest/coverage-istanbul": "0.10.6"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "api": "workspace:*",
    "config": "workspace:*",
    "graphql": "^16.14.2",
    "minio": "^8.0.7",
    "pdf-lib": "^1.17.1",
    "script": "workspace:*",
    "server": "workspace:*",
    "ts-proto": "^2.11.8"
  },
  "scripts": {
    "dev": "bun run index.ts --watch --verbose",
    "k8s:build": "cd ../.. && docker build -f servers/payroll/Dockerfile -t payroll:local . && docker build -f servers/payroll/Dockerfile --target migrate -t payroll-migrate:local .",
    "gen": "bun ../../packages/script/src/bin/generate-api.ts",
    "test": "rstest",
    "postinstall": "prisma generate",
    "vault:provision": "cd ../.. && docker compose run --rm ansible ansible-playbook services/vault/ansible/provision.yml -e @servers/payroll/ansible/vars.yml"
  }
}
