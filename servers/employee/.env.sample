BUN_TARGET=bun-linux-x64

# gRPC
GRPC_PORT=5001

# GraphQL
GRAPHQL_PORT=4001

# Database (Vault-backed at runtime — see packages/server/CLAUDE.md's Database section).
# DATABASE_URL is still required by prisma.config.ts for Prisma CLI operations.
DATABASE_URL=postgresql://myuser:mypassword@localhost:5101/employee
DB_HOST=localhost
DB_PORT=5101
DB_NAME=employee
VAULT_ADDR=http://localhost:8200
VAULT_DB_ROLE=employee-role

# Authentik (AuthentikPlugin — creates the Authentik account for a newly registered employee).
# No provisioning script exists yet for this server (unlike servers/auth's `auth:provision`) —
# a service account + API token with at least add_user/reset_user_password RBAC needs to be
# provisioned by hand (or a future `services/authentik/ansible` role) before these are real values.
AUTHENTIK_URL=http://localhost:9000
AUTHENTIK_OAUTH_CLIENT_ID=changeme
AUTHENTIK_OAUTH_CLIENT_SECRET=changeme
AUTHENTIK_API_TOKEN=changeme
