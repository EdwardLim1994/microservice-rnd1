BUN_TARGET=bun-linux-x64

# gRPC
GRPC_PORT=5001

# GraphQL
GRAPHQL_PORT=4001

# Database (Vault-backed at runtime — see packages/server/CLAUDE.md's Database section).
# DATABASE_URL is still required by prisma.config.ts for Prisma CLI operations.
DATABASE_URL=postgresql://myuser:mypassword@localhost:5101/employee
DB_HOST=localhost
DB_PORT=5101
DB_NAME=employee
VAULT_ADDR=http://localhost:8200
VAULT_DB_ROLE=employee-role

# Authentik (see services/authentik/CLAUDE.md) — AuthentikClient only needs createUser()'s
# Admin API token here, but its constructor requires all four vars unconditionally. Reuses the
# same values servers/auth provisions via `bun run auth:provision` (add_user/view_user/
# reset_user_password scope already covers createUser()'s two calls) — no separate provisioning
# role for this server, copy these from servers/auth/.env after running its auth:provision once.
AUTHENTIK_URL=http://localhost:9000
AUTHENTIK_OAUTH_CLIENT_ID=
AUTHENTIK_OAUTH_CLIENT_SECRET=
AUTHENTIK_API_TOKEN=
