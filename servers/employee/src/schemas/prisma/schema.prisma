generator client {
    provider = "prisma-client-js"
    output   = "../../../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Employee {
    id              String     @id @default(cuid())
    firstName       String
    lastName        String
    gender          String
    email           String     @unique
    grossSalary     Float
    salaryPerDay    Float
    authentikUserId String?
    supervisorId    String?
    supervisor      Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
    reports         Employee[] @relation("EmployeeSupervisor")
    createdAt       DateTime   @default(now())
    updatedAt       DateTime   @updatedAt
}
