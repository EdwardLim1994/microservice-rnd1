{
  "name": "auth",
  "version": "1.1.1",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@graphql-codegen/add": "^7.0.1",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/schema-ast": "^6.0.1",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-resolvers": "^6.0.2",
    "@rstest/core": "^0.10.6",
    "@rstest/coverage-istanbul": "0.10.6"
  },
  "dependencies": {
    "server": "workspace:*",
    "config": "workspace:*",
    "graphql": "^16.14.2",
    "api": "workspace:*",
    "script": "workspace:*"
  },
  "scripts": {
    "dev": "bun run index.ts --watch --verbose",
    "k8s:build": "cd ../.. && docker build -f servers/auth/Dockerfile -t auth:local .",
    "gen": "bun ../../packages/script/src/bin/generate-api.ts",
    "test": "rstest",
    "auth:provision": "cd ../.. && docker compose run --rm authentik-ansible ansible-playbook services/authentik/ansible/provision.yml -e @servers/auth/ansible/vars.yml",
    "vault:provision": "cd ../.. && docker compose run --rm ansible ansible-playbook services/vault/ansible/provision.yml -e @servers/auth/ansible/vars.yml"
  }
}
