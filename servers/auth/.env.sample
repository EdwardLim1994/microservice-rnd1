BUN_TARGET=bun-linux-x64

# GraphQL
GRAPHQL_PORT=4003

# TLS (mTLS to Apollo Router — see services/vault/CLAUDE.md's PKI section and
# packages/server/CLAUDE.md's TLS section). VAULT_ROLE_ID/VAULT_SECRET_ID are filled in by
# `bun run vault:provision` (see package.json), never committed here.
VAULT_ADDR=http://localhost:8200
VAULT_TLS_ROLE=auth-tls-role

# Authentik (see services/authentik/CLAUDE.md)
AUTHENTIK_URL=http://localhost:9000
# Filled in by `bun run auth:provision` — see services/authentik/ansible/
AUTHENTIK_OAUTH_CLIENT_ID=
AUTHENTIK_OAUTH_CLIENT_SECRET=
AUTHENTIK_API_TOKEN=
