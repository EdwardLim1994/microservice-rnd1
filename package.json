{
	"name": "rnd1",
	"devDependencies": {
		"@types/bun": "latest",
		"@turbo/gen": "^2.10.2",
		"config": "workspace:*"
	},
	"dependencies": {
		"turbo": "^2.10.4"
	},
	"workspaces": [
		"apps/*",
		"frontends/*",
		"services/*",
		"packages/*",
		"servers/*",
		"generators/*"
	],
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"gen": "turbo run gen && turbo run build --filter=api",
		"compile": "turbo run compile",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"supergraph": "turbo run supergraph",
		"generate": "turbo gen",
		"k8s:build": "eval \"$(minikube docker-env)\" && turbo run k8s:build"
	}
}
