{
	"name": "rnd1",
	"devDependencies": {
		"@types/bun": "latest"
	},
	"dependencies": {
		"turbo": "^2.9.18"
	},
	"workspaces": [
		"apps/*",
		"services/*",
		"packages/*",
		"servers/*"
	],
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"build:lib": "turbo run build:lib",
		"test": "turbo run test",
		"gen": "turbo run gen && turbo run build:lib",
		"compile": "turbo run compile",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"supergraph": "turbo run supergraph"
	}
}
