{
  "name": "rnd1",
  "version": "1.2.0-rc2",
  "devDependencies": {
    "@types/bun": "latest",
    "@turbo/gen": "^2.10.2",
    "config": "workspace:*"
  },
  "dependencies": {
    "turbo": "^2.10.4"
  },
  "workspaces": [
    "apps/*",
    "frontends/*",
    "services/*",
    "packages/*",
    "servers/*",
    "generators/*",
    "e2e"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "gen": "turbo run gen && turbo run build --filter=api",
    "compile": "turbo run compile",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "supergraph": "turbo run supergraph",
    "generate": "turbo gen",
    "k8s:build": "eval \"$(minikube docker-env)\" && turbo run k8s:build",
    "release:cut": "bun ./packages/script/src/bin/release-manager.ts cut-release",
    "release:bump-rc": "bun ./packages/script/src/bin/release-manager.ts bump-rc",
    "release:promote": "bun ./packages/script/src/bin/release-manager.ts promote",
    "release:hotfix": "bun ./packages/script/src/bin/release-manager.ts hotfix",
    "release:touched-apps": "bun ./packages/script/src/bin/release-manager.ts touched-apps"
  }
}
