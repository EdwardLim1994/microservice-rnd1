{
	"name": "rnd1",
	"version": "1.1.0",
	"devDependencies": {
		"@types/bun": "latest",
		"@turbo/gen": "^2.10.6",
		"config": "workspace:*"
	},
	"dependencies": {
		"turbo": "^2.10.6"
	},
	"workspaces": [
		"apps/servers/*",
		"apps/mfe/*",
		"apps/mobile/*",
		"apps/web/*",
		"apps/*",
		"services/*",
		"packages/*"
	],
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"gen": "turbo run gen && turbo run build --filter=api",
		"compile": "turbo run compile",
		"format": "turbo run format",
		"lint": "turbo run lint",
		"check": "turbo run check",
		"supergraph": "turbo run supergraph",
		"generate": "turbo gen"
	}
}
