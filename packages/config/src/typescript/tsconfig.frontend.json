{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "ES2020"],
    "target": "ES2020",
    "jsx": "react-jsx",
    "types": ["@rsbuild/core/types", "node"],
    "useDefineForClassFields": true,

    "verbatimModuleSyntax": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
