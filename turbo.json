{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"outputs": ["dist/**"]
		},
		"build:lib": {
			"outputs": ["dist/**"]
		},
		"gen": {
			"outputs": ["src/generated/**"]
		},
		"compile": {
			"dependsOn": ["^build"],
			"outputs": ["dist/bin/**"]
		},
		"format": {},
		"lint": {},
		"supergraph": {}
	}
}
