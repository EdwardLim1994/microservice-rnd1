{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"build": {
			"outputs": ["dist/**"],
			"env": ["PUBLIC_*", "*_HOST", "*_PORT"]
		},
		"gen": {
			"outputs": ["src/generated/**"]
		},
		"compile": {
			"dependsOn": ["^build"],
			"outputs": ["dist/bin/**"]
		},
		"format": {},
		"lint": {},
		"check": {},
		"test": {
			"dependsOn": ["^build"]
		},
		"supergraph": {
			"cache": false
		}
	}
}
