BUN_TARGET=bun-linux-x64

# gRPC
GRPC_PORT=5003

# LoggerPlugin (packages/server) — publishes every log.info()/warn()/error() call onto Kafka's
# shared "log-events" topic. No consumer currently reads this topic (the previous one,
# apps/servers/log-collector, was removed).
OTEL_SERVICE_NAME=payroll
KAFKA_BROKERS=localhost:29092

# Database — static superuser creds, also read by prisma.config.ts for Prisma CLI
# operations (generate/migrate).
DATABASE_URL=postgresql://myuser:mypassword@localhost:5101/payroll
DB_HOST=localhost
DB_PORT=5101
DB_NAME=payroll
