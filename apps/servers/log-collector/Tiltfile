# Every path below is relative to *this* Tiltfile's own directory (apps/servers/log-collector/) —
# Tilt resolves relative paths that way for every function, not repo-root-relative. Dockerfile's
# own header says "Build context must be repo root", hence "../../.." here, not ".".
load('ext://restart_process', 'docker_build_with_restart')

docker_build_with_restart(
    "log-collector",
    "../../..",
    dockerfile="./Dockerfile",
    target="development",
    entrypoint=["bun", "run", "index.ts"],
    live_update=[
        sync("./src", "/app/apps/servers/log-collector/src"),
        run("date > /.restart-proc"),
    ],
)

k8s_yaml(helm(
    "./helm",
    name="log-collector",
    namespace="server-apps",
))

# services/* is no longer Tilt-managed — run `terraform apply` in services/terraform once
# (against minikube) before `tilt up` here.
k8s_resource(
    "log-collector",
    labels=["servers"],
)
