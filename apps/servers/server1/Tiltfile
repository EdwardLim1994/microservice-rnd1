# Every path below is relative to *this* Tiltfile's own directory (apps/servers/server1/) — Tilt
# resolves relative paths that way for every function, not repo-root-relative. Dockerfile's own
# header says "Build context must be repo root", hence "../../.." here, not ".".
load('ext://restart_process', 'docker_build_with_restart')

# restart_container() is deprecated for k8s resources (Tilt now recommends this extension
# instead) — docker_build_with_restart wraps the "development" stage's own entrypoint (see
# Dockerfile's `ENTRYPOINT ["bun", "run", "index.ts"]`) so a live_update re-executes bun directly
# rather than restarting the whole container.
docker_build_with_restart(
    "server1",
    "../../..",
    dockerfile="./Dockerfile",
    target="development",
    entrypoint=["bun", "run", "index.ts"],
    live_update=[
        sync("./src", "/app/apps/servers/server1/src"),
        sync("./generated", "/app/apps/servers/server1/generated"),
        run("date > /.restart-proc"),
    ],
)

# dbPassword/redisPassword: db.yaml.hbs/redis.yaml.hbs's own superuser/admin passwords fall back
# to a `lookup` of the already-set Secret value — but Tilt's own helm() has no live cluster
# access at all, so `lookup` always returns nothing here, minting a *new* random password on
# every single Tiltfile reconcile while server1-db's own pod (fixed at its last boot) and
# server1-migrate's Job (a literal env value, immutable once created) each keep whatever stale
# value they already had — three different passwords, "Authentication failed" for `myuser`.
# Stable literals here fix that; a real `helm install`/Terraform never sets this override.
k8s_yaml(helm(
    "./helm",
    name="server1",
    namespace="servers",
    set=[
        "dbPassword=server1-tilt-local-dev-db-password",
        "redisPassword=server1-tilt-local-dev-redis-password",
    ],
))

# "services-ready" (services/Tiltfile) gates everything below on every services/* resource
# actually being up first — server1's own db-provision/redis-provision Jobs need Vault's
# Kubernetes-auth role to already exist (services/vault/helm/templates/k8s-auth-provision-job.yaml),
# not just Vault's pod running.
k8s_resource(
    "server1",
    resource_deps=["services-ready"],
    labels=["servers"],
)


docker_build("server1-migrate", "../../..", dockerfile="./Dockerfile", target="migrate")

k8s_resource(
    "server1-db",
    resource_deps=["services-ready"],
    port_forwards=["5101:5432"],
    labels=["servers"],
)

k8s_resource(
    "server1-migrate",
    resource_deps=["server1-db"],
    labels=["servers"],
)

# redis.yaml's Deployment — no explicit k8s_resource() call before, so it fell into Tilt's
# default "unlabeled" bucket instead of showing up under "servers" in the UI like everything else
# here.
k8s_resource(
    "server1-redis",
    resource_deps=["services-ready"],
    labels=["servers"],
)

# Also depends on "server1-migrate", not just "server1-db": this Deployment's own
# create-publication initContainer (see debezium.yaml) needs public.item to already exist,
# which only server1-migrate guarantees.
k8s_resource(
    "server1-debezium",
    resource_deps=["server1-db", "server1-migrate"],
    labels=["servers"],
)

# Tilt disambiguates same-named Job+CronJob pairs as "<name>:job"/"<name>:cronjob" — a plain
# "server1-db-provision" isn't a valid resource name here, both halves need addressing. Also
# depends on "server1" itself, not just "server1-db"/"server1-redis": db-provision-main.sh/
# redis-provision-main.sh both end with `kubectl rollout restart/status deployment/server1` with
# no retry loop of their own, so without this the Job can hit "deployment server1 not found" if
# it runs before server1's own Deployment even exists yet and burn through backoffLimit needing a
# manual re-trigger.
k8s_resource(
    "server1-db-provision:job",
    resource_deps=["services-ready", "server1-db", "server1"],
    labels=["servers"],
)

k8s_resource(
    "server1-db-provision:cronjob",
    resource_deps=["services-ready", "server1-db", "server1"],
    labels=["servers"],
)

k8s_resource(
    "server1-redis-provision:job",
    resource_deps=["services-ready", "server1-redis", "server1"],
    labels=["servers"],
)

k8s_resource(
    "server1-redis-provision:cronjob",
    resource_deps=["services-ready", "server1-redis", "server1"],
    labels=["servers"],
)
