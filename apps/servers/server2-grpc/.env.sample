BUN_TARGET=bun-linux-x64

# gRPC
GRPC_PORT=5002

# Database — static superuser creds, also read by prisma.config.ts for Prisma CLI
# operations (generate/migrate).
DATABASE_URL=postgresql://myuser:mypassword@localhost:5101/server2-grpc
DB_HOST=localhost
DB_PORT=5101
DB_NAME=server2-grpc

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=server2-grpc
KAFKA_GROUP_ID=server2-grpc-group

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=meilimasterkey
