# Every path below is relative to *this* Tiltfile's own directory (apps/servers/server2-grpc/) — Tilt
# resolves relative paths that way for every function, not repo-root-relative. Dockerfile's own
# header says "Build context must be repo root", hence "../../.." here, not ".".
load('ext://restart_process', 'docker_build_with_restart')

# restart_container() is deprecated for k8s resources (Tilt now recommends this extension
# instead) — docker_build_with_restart wraps the "development" stage's own entrypoint (see
# Dockerfile's `ENTRYPOINT ["bun", "run", "index.ts"]`) so a live_update re-executes bun directly
# rather than restarting the whole container.
docker_build_with_restart(
    "server2-grpc",
    "../../..",
    dockerfile="./Dockerfile",
    target="development",
    entrypoint=["bun", "run", "index.ts"],
    live_update=[
        sync("./src", "/app/apps/servers/server2-grpc/src"),
        run("date > /.restart-proc"),
    ],
)

# Own namespace declared once, centrally, in apps/servers/Tiltfile (shared "server-apps" —
# every server's app chart lands there now, not a dedicated namespace per server).

# postgres/Vault-provisioning moved to server2-grpc-infra (Terraform-applied once, see
# apps/terraform) — this chart is just the app Deployment/Service/migrate Job now, and needs
# server2-grpc-infra to already exist (run `terraform apply` there first).
#
# dbPassword: this chart's own env.yaml builds DATABASE_URL by `lookup`-ing server2-grpc-infra's
# real password Secret — but Tilt's own helm() has no live cluster access at all, so that
# `lookup` always returns nothing here. Unlike the old colocated setup, there's no fixed literal
# to fall back to either: server2-grpc-infra's password is a Terraform-generated random value,
# not a Tilt-controlled override. Read it straight from the (already Terraform-applied) cluster
# instead, same trick server1-grpc/Tiltfile uses.
db_password = str(local(
    "kubectl get secret server2-grpc-db-secret -n server-infra -o jsonpath='{.data.password}' | base64 -d",
    quiet=True,
)).strip()

k8s_yaml(helm(
    "./helm",
    name="server2-grpc",
    namespace="server-apps",
    set=[
        "dbPassword=" + db_password,
    ],
))

k8s_resource(
    "server2-grpc",
    labels=["servers"],
)

docker_build("server2-grpc-migrate", "../../..", dockerfile="./Dockerfile", target="migrate")

k8s_resource(
    "server2-grpc-migrate",
    labels=["servers"],
)
