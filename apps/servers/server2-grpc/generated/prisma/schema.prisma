generator client {
  provider = "prisma-client-js"
  output   = "../../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// itemId references server1's Item by id (cross-service, no FK — server1 owns that row). Item2's
// only parent now — Collection was removed, Item (federated in from server1) is the sole owner.
model Item2 {
  id        String   @id @default(uuid())
  name      String
  itemId    String
  createdAt DateTime @default(now())

  @@index([itemId])
}
