# Every path below is relative to *this* Tiltfile's own directory (apps/servers/server1-grpc/) — Tilt
# resolves relative paths that way for every function, not repo-root-relative. Dockerfile's own
# header says "Build context must be repo root", hence "../../.." here, not ".".
load('ext://restart_process', 'docker_build_with_restart')

# restart_container() is deprecated for k8s resources (Tilt now recommends this extension
# instead) — docker_build_with_restart wraps the "development" stage's own entrypoint (see
# Dockerfile's `ENTRYPOINT ["bun", "run", "index.ts"]`) so a live_update re-executes bun directly
# rather than restarting the whole container.
docker_build_with_restart(
    "server1-grpc",
    "../../..",
    dockerfile="./Dockerfile",
    target="development",
    entrypoint=["bun", "run", "index.ts"],
    live_update=[
        sync("./src", "/app/apps/servers/server1-grpc/src"),
        sync("./generated", "/app/apps/servers/server1-grpc/generated"),
        run("date > /.restart-proc"),
    ],
)

# postgres/redis/debezium/Vault-provisioning moved to server1-grpc-infra (Terraform-applied once,
# see apps/terraform) — this chart is just the app Deployment/Service/migrate Job now,
# and needs server1-grpc-infra to already exist (run `terraform apply` there first).
#
# dbPassword/redisPassword: this chart's own env.yaml builds DATABASE_URL/REDIS_URL by `lookup`-ing
# server1-grpc-infra's real password Secrets — but Tilt's own helm() has no live cluster access at
# all, so that `lookup` always returns nothing here. Unlike the old same-chart setup, there's no
# fixed literal to fall back to either: server1-grpc-infra's passwords are Terraform-generated
# random values, not a Tilt-controlled override. Read them straight from the (already
# Terraform-applied) cluster instead, same trick services/vault/Tiltfile used to use for
# traefik's ClusterIP before that chart moved to Terraform too.
db_password = str(local(
    "kubectl get secret server1-grpc-db-secret -n server1-grpc-infra -o jsonpath='{.data.password}' | base64 -d",
    quiet=True,
)).strip()
redis_password = str(local(
    "kubectl get secret server1-grpc-redis-admin-secret -n server1-grpc-infra -o jsonpath='{.data.password}' | base64 -d",
    quiet=True,
)).strip()

k8s_yaml(helm(
    "./helm",
    name="server1-grpc",
    namespace="server1-grpc-app",
    set=[
        "dbPassword=" + db_password,
        "redisPassword=" + redis_password,
    ],
))

k8s_resource(
    "server1-grpc",
    port_forwards=["5001:5001"],
    labels=["servers"],
)

docker_build("server1-grpc-migrate", "../../..", dockerfile="./Dockerfile", target="migrate")

k8s_resource(
    "server1-grpc-migrate",
    labels=["servers"],
)
