{
  "title": "server1-grpc: Postgres & Redis",
  "uid": "server1-grpc-db-redis",
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "panels": [
    { "type": "row", "title": "Postgres (server1-grpc-db)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat",
      "title": "Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pg_up{job=\"server1-grpc-postgres\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Active connections",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pg_stat_database_numbackends{job=\"server1-grpc-postgres\", datname=\"server1-grpc\"}", "legendFormat": "connections", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transactions/sec",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{job=\"server1-grpc-postgres\", datname=\"server1-grpc\"}[5m])", "legendFormat": "commits/s", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{job=\"server1-grpc-postgres\", datname=\"server1-grpc\"}[5m])", "legendFormat": "rollbacks/s", "refId": "B" }
      ]
    },
    { "type": "row", "title": "Redis (server1-grpc-redis)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "type": "stat",
      "title": "Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_up{job=\"server1-grpc-redis\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connected clients",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "redis_connected_clients{job=\"server1-grpc-redis\"}", "legendFormat": "clients", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": { "h": 8, "w": 5, "x": 14, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "redis_memory_used_bytes{job=\"server1-grpc-redis\"}", "legendFormat": "used", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commands/sec",
      "gridPos": { "h": 8, "w": 5, "x": 19, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(redis_commands_processed_total{job=\"server1-grpc-redis\"}[5m])", "legendFormat": "ops/s", "refId": "A" }
      ]
    }
  ]
}
