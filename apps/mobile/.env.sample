# localhost only works in a simulator on this same machine. On a physical
# device (e.g. Expo Go over --host tunnel), the device can't reach this
# machine's localhost — point this at a reachable address instead, e.g. this
# machine's Tailscale IP (`tailscale ip -4`) if both are on the same tailnet.
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
