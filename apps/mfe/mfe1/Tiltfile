# Every path below is relative to *this* Tiltfile's own directory (apps/mfe/mfe1/) — Tilt resolves
# relative paths that way for every function, not repo-root-relative. Dockerfile's own header says
# "Build context must be repo root", hence "../../.." here, not ".".
load('ext://restart_process', 'docker_build_with_restart')

# restart_container() is deprecated for k8s resources (Tilt now recommends this extension
# instead) — docker_build_with_restart wraps the "development" stage's own entrypoint (see
# Dockerfile's `ENTRYPOINT ["bun", "run", "rsbuild", "dev"]`) so a live_update re-executes bun
# directly rather than restarting the whole container.
docker_build_with_restart(
    "mfe1",
    "../../..",
    dockerfile="./Dockerfile",
    target="development",
    entrypoint=["bun", "run", "rsbuild", "dev"],
    live_update=[
        sync("./src", "/app/apps/mfe/mfe1/src"),
        run("date > /.restart-proc"),
    ],
)

# Own namespace declared once, centrally, in apps/web/Tiltfile (shared "apps" — every web/mfe
# app's chart lands there, not a dedicated namespace per app).

k8s_yaml(helm(
    "./helm",
    name="mfe1",
    namespace="apps",
))

k8s_resource(
    "mfe1",
    port_forwards=["3001:3001"],
    labels=["mfe"],
)
