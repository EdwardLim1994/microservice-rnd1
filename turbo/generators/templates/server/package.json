{
	"name": "{{ name }}",
	"module": "index.ts",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"devDependencies": {
		"@types/bun": "latest"
	},
	"dependencies": {
		"server": "workspace:*",
		"config": "workspace:*"
	},
	"scripts": {
		"dev": "bun run index.ts --watch --verbose",
		"k8s:build": "cd ../.. && docker build -f servers/{{ name }}/Dockerfile -t {{ name }}:local ."
	}
}
