apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ name }}-grpc-env
  namespace: \{{ .Values.namespace }}
data:
  GRPC_PORT: "{{ port }}"

---
# Stable in-cluster DNS ({{ name }}, or {{ name }}.\{{ .Values.namespace }}.svc.cluster.local
# from another namespace) so another server's gRPC client can actually reach this Deployment —
# nothing else in this chart provides one.
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: \{{ .Values.namespace }}
spec:
  type: ClusterIP
  selector:
    app: {{ name }}
  ports:
    - name: grpc
      port: {{ port }}
      targetPort: {{ port }}
