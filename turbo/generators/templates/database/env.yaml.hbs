\{{- $dbSecret := lookup "v1" "Secret" .Values.infraNamespace "{{ name }}-db-secret" }}
\{{- $dbPassword := "" }}
\{{- if $dbSecret }}
\{{- $dbPassword = index $dbSecret.data "password" | b64dec }}
\{{- else }}
\{{- $dbPassword = .Values.dbPassword }}
\{{- end }}
# Consumed via envFrom by this chart's own deployment.yaml and by {{ name }}-migrate below.
# DB_HOST/DB_PORT/DB_NAME only — DATABASE_URL itself lives in {{ name }}-secret (below), not
# here, since it holds Vault-minted credentials rather than a static value safe for a ConfigMap.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ name }}-env
  namespace: \{{ .Values.namespace }}
data:
  # Fully-qualified — {{ name }}-db lives in {{ name }}-infra now, a different namespace.
  DB_HOST: {{ name }}-db.\{{ .Values.infraNamespace }}.svc.cluster.local
  DB_PORT: "5432"
  DB_NAME: {{ name }}

---
# DATABASE_URL for the app's own Deployment (envFrom secretRef) — starts out pointing at
# {{ name }}-infra's real superuser creds (read via cross-namespace `lookup`, see the top of
# this file) so the app can still boot before {{ name }}-infra's db-provision-job.yaml
# post-install hook has run once; that hook immediately overwrites this key with Vault-minted
# leaf creds and rolls the Deployment. See that Job for the whole rotation story, and this
# chart's own values.yaml for why $dbPassword's fallback branch (Tilt, offline template) has to
# be kept in sync with {{ name }}-infra's own dbPassword override.
#
# ponytail: Tilt re-renders this Secret (guessed superuser creds, not the current Vault-minted
# ones) on every reconcile that touches this chart's own template files — {{ name }}-infra's
# db-provision-job only re-patches it on ITS OWN Terraform apply or its 6h CronJob, not on every
# `tilt up`. If DATABASE_URL looks stale after editing a chart template (not app code — that
# path uses live_update, never touches this file), manually re-run the provision Job:
# `kubectl create job --from=cronjob/{{ name }}-db-provision {{ name }}-db-provision-manual -n server-infra`
apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-secret
  namespace: \{{ .Values.namespace }}
type: Opaque
stringData:
  DATABASE_URL: postgresql://myuser:\{{ $dbPassword }}@{{ name }}-db.\{{ .Values.infraNamespace }}.svc.cluster.local:5432/{{ name }}

---
apiVersion: batch/v1
kind: Job
metadata:
  # A Job's spec is immutable, and ttlSecondsAfterFinished (below) only deletes it *after* it
  # finishes — a re-trigger issued while a still-in-flight Job from a previous run is retrying
  # (backoffLimit) still needs it deleted first (`kubectl delete job {{ name }}-migrate`), or
  # the apply fails trying to update a field it can't change in place. Doesn't come up in the
  # normal case (Job already finished and TTL-cleaned itself up by the time you re-trigger).
  name: {{ name }}-migrate
  namespace: \{{ .Values.namespace }}
  labels:
    app: {{ name }}-migrate
spec:
  # backoffLimit is a safety net for transient failures after Postgres is up (migration
  # conflicts, brief network blips) — the initContainer below (wired by
  # DatabaseGenerator.ts's injectDatabaseEnvYaml action) is what actually guards the
  # fresh-cluster race: Postgres's own readinessProbe gates whether its Service has any
  # endpoints at all, so without it, connections here fail outright (no queueing) and can
  # exhaust these retries before Postgres's first-time initdb ever finishes.
  backoffLimit: 6
  # Runs once — Prisma's own migration-history table already makes re-runs a no-op, but the
  # point here is Job hygiene: without this, a completed Job sits around forever (immutable spec,
  # blocks any future `kubectl apply`/Tilt reconcile of the same name until manually deleted).
  ttlSecondsAfterFinished: 60
  template:
    metadata:
      labels:
        app: {{ name }}-migrate
    spec:
      restartPolicy: OnFailure
      containers:
        - name: migrate
          image: {{ name }}-migrate
          env:
            # Fully-qualified — {{ name }}-db lives in {{ name }}-infra now.
            - name: DATABASE_URL
              value: postgresql://myuser:\{{ $dbPassword }}@{{ name }}-db.\{{ .Values.infraNamespace }}.svc.cluster.local:5432/{{ name }}
