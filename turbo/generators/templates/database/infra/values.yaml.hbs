# Shared namespace — every server's infra chart (Postgres/Redis/etc.) lands here, not a
# dedicated one per server. Collisions between servers are avoided by prefixing every object name
# with this server's own name ({{ name }}-db, {{ name }}-vault-db-provision, etc.), not by
# namespace. This chart is deploy-once (Terraform-applied); the app chart is Tilt-iterated. See
# root-level comment in apps/terraform/main.tf.
namespace: server-infra

# Where the app chart's own Deployment/Secret live — db-provision-job.yaml patches DATABASE_URL
# and rolls the Deployment there on every credential rotation, so this chart's own ServiceAccount
# needs a Role/RoleBinding scoped into that namespace too, not just its own. Also shared across
# every server now. See db-provision-job.yaml's own header comment for the full cross-namespace
# RBAC shape.
appNamespace: server-apps

# Empty by default — db.yaml's Postgres superuser password falls back to a `lookup` of the
# already-set value (real `helm install`/Terraform) or a fresh `randAlphaNum` on first install.
# Tilt's own helm() has no live cluster access at all, so `lookup` always returns nothing there —
# set this via Tiltfile's set=["dbPassword=..."] to get a value that stays stable across every
# Tilt reconcile instead of drifting on every single one. The app chart's own values.yaml must be
# given the exact same override (its own bootstrap Secret construction does the same lookup
# against THIS chart's Secret, in THIS chart's namespace) — see that chart's values.yaml.
dbPassword: ""

# See helm/templates/db-provision-job.yaml + helm/files/db-provision-*.sh — the Vault dynamic
# Postgres role minted for the app's own Deployment.
dbProvision:
  # How often the CronJob re-mints creds. Keep this comfortably inside defaultTtl (a 6h poll
  # against a 24h TTL means several missed runs in a row before a lease is ever actually at risk
  # of expiring) — this is what keeps a long-running pod's DB credential from expiring out from
  # under it in both dev and prod (dev-mode Vault also loses all lease state on every restart).
  schedule: "0 */6 * * *"
  defaultTtl: "24h"
  maxTtl: "720h"
