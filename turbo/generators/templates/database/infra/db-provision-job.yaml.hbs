# Vault's database secrets engine, pointed at this server's own {{ name }}-db (see db.yaml) —
# same idea as services/vault/helm/templates/db-provision-job.yaml (authentik's), simplified:
# this only ever patches the app chart's own {{ name }}-secret and rolls its Deployment.
#
# Cross-namespace: this Job's own ServiceAccount/pod lives in the shared "server-infra" namespace
# (this chart's own namespace), but the Secret/Deployment it patches live in the shared
# "server-apps" namespace (the app chart's namespace, Tilt-owned) — a plain same-namespace Role
# wouldn't reach it. The Role/RoleBinding below are deliberately created IN .Values.appNamespace
# (not .Values.namespace like everything else in this chart) with this namespace's ServiceAccount
# as the RoleBinding's subject — valid k8s RBAC (a RoleBinding's subjects can reference a
# ServiceAccount in any namespace) and doesn't need the app namespace to exist yet at plan-time
# beyond apply-time (see apps/terraform/main.tf, which creates both namespaces upfront
# specifically so this ordering never bites regardless of whether Terraform or Tilt runs first).
#
# ServiceAccount/Role/RoleBinding are named "{{ name }}-vault-db-provision", not a plain
# "vault-db-provision" shared by every server — since every server's infra chart lands in the
# same shared "server-infra" namespace, a per-server prefix is what avoids a
# same-name-same-namespace collision between two servers' charts. See
# services/vault/helm/templates/k8s-auth-provision-job.yaml's bound_service_account_names="*"
# for the Vault-side half of this.
#
# Split across two containers by tool, same reasoning as services/vault/helm's own
# db-provision-job.yaml: an initContainer (hashicorp/vault image) runs every `vault` CLI command
# and writes its results to a shared emptyDir volume; the main container (bitnami/kubectl image)
# only ever runs `kubectl`/`curl` against those files — neither image has both toolsets. The one
# Vault-API call the main container still needs (revoking the previous lease) uses plain `curl`
# against Vault's HTTP API instead of the `vault` CLI.
#
# Scripts live in files/db-provision-init.sh and files/db-provision-main.sh, loaded via
# `.Files.Get` (bypasses Helm's own Go-templating for that file's content entirely) rather than
# inlined here — the init script's own Vault template placeholders (username/password/expiration)
# use Vault's mustache-style syntax, the same delimiter Helm's own Go templates use, and
# .Files.Get is what lets those stay literal instead of every single one needing Go-template
# string-literal escaping.
#
# Runs on two triggers, both loading the same two scripts:
#   1. a post-install/post-upgrade hook Job — fresh creds on every deploy.
#   2. a CronJob, on Values.dbProvision.schedule — well inside the minted lease's
#      Values.dbProvision.defaultTtl by convention (see values.yaml's own comment) — the fix for
#      "a long-running pod outlives its lease and Vault's own background expiration drops the
#      credential out from under it" in BOTH dev and prod. Dev-mode Vault also loses all lease
#      state on every restart (in-memory storage), so this is what makes dev self-healing too,
#      not just a prod nice-to-have. Always re-mints rather than a plain `vault lease renew` —
#      the same already-idempotent scripts, no second renew-only code path that could drift or
#      fail differently.
#
# Always authenticates via Vault's Kubernetes auth method — see
# services/vault/helm/templates/k8s-auth-provision-job.yaml, which sets up the "db-provision"
# Kubernetes-auth role in both dev and prod for exactly this reason: this chart lives outside
# vault's own namespace, so the dev-mode static root token (only readable within vault's own
# namespace) was never reachable from here to begin with.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ name }}-vault-db-provision
  namespace: \{{ .Values.namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ name }}-vault-db-provision
  namespace: \{{ .Values.appNamespace }}
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: ["{{ name }}-secret"]
    verbs: ["get", "patch"]
  - apiGroups: ["apps"]
    resources: ["deployments"]
    resourceNames: ["{{ name }}"]
    verbs: ["get", "patch", "watch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ name }}-vault-db-provision
  namespace: \{{ .Values.appNamespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: {{ name }}-vault-db-provision
subjects:
  - kind: ServiceAccount
    name: {{ name }}-vault-db-provision
    namespace: \{{ .Values.namespace }}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ name }}-db-provision
  namespace: \{{ .Values.namespace }}
  annotations:
    "helm.sh/hook": post-install,post-upgrade
    "helm.sh/hook-weight": "1"
    "helm.sh/hook-delete-policy": before-hook-creation
spec:
  backoffLimit: 5
  template:
    spec:
      # Never, not OnFailure — same reasoning as services/vault/helm/values.yaml's
      # jobRestartPolicy: a failed pod sticks around for `kubectl logs` instead of being
      # replaced in place with nothing left to inspect.
      restartPolicy: Never
      serviceAccountName: {{ name }}-vault-db-provision
      automountServiceAccountToken: true
      initContainers:
        - name: db-provision-init
          image: hashicorp/vault:1.18
          env:
            - name: VAULT_ADDR
              value: "http://vault.infra.svc.cluster.local:8200"
            - name: PGADMIN_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-db-secret
                  key: password
            - name: DB_DEFAULT_TTL
              value: \{{ .Values.dbProvision.defaultTtl | quote }}
            - name: DB_MAX_TTL
              value: \{{ .Values.dbProvision.maxTtl | quote }}
          command:
            - sh
            - -c
            - |
              \{{ .Files.Get "files/db-provision-init.sh" | nindent 14 }}
          volumeMounts:
            - name: shared
              mountPath: /shared
      containers:
        - name: db-provision-main
          image: bitnami/kubectl@sha256:95de17e6eb92da83a58c90a9df0c4cede634f898d2e6b92ea04f4a6ee6ace08d
          env:
            - name: VAULT_ADDR
              value: "http://vault.infra.svc.cluster.local:8200"
            - name: APP_NAMESPACE
              value: \{{ .Values.appNamespace }}
          command:
            - sh
            - -c
            - |
              \{{ .Files.Get "files/db-provision-main.sh" | nindent 14 }}
          volumeMounts:
            - name: shared
              mountPath: /shared
      volumes:
        - name: shared
          emptyDir: {}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ name }}-db-provision
  namespace: \{{ .Values.namespace }}
spec:
  # 6h poll against a 24h default_ttl (see values.yaml) — several missed runs in a row before
  # the lease is ever actually at risk of expiring.
  schedule: \{{ .Values.dbProvision.schedule | quote }}
  jobTemplate:
    spec:
      backoffLimit: 5
      template:
        spec:
          restartPolicy: Never
          serviceAccountName: {{ name }}-vault-db-provision
          automountServiceAccountToken: true
          initContainers:
            - name: db-provision-init
              image: hashicorp/vault:1.18
              env:
                - name: VAULT_ADDR
                  value: "http://vault.infra.svc.cluster.local:8200"
                - name: PGADMIN_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: {{ name }}-db-secret
                      key: password
                - name: DB_DEFAULT_TTL
                  value: \{{ .Values.dbProvision.defaultTtl | quote }}
                - name: DB_MAX_TTL
                  value: \{{ .Values.dbProvision.maxTtl | quote }}
              command:
                - sh
                - -c
                - |
                  \{{ .Files.Get "files/db-provision-init.sh" | nindent 18 }}
              volumeMounts:
                - name: shared
                  mountPath: /shared
          containers:
            - name: db-provision-main
              image: bitnami/kubectl@sha256:95de17e6eb92da83a58c90a9df0c4cede634f898d2e6b92ea04f4a6ee6ace08d
              env:
                - name: VAULT_ADDR
                  value: "http://vault.infra.svc.cluster.local:8200"
                - name: APP_NAMESPACE
                  value: \{{ .Values.appNamespace }}
              command:
                - sh
                - -c
                - |
                  \{{ .Files.Get "files/db-provision-main.sh" | nindent 18 }}
              volumeMounts:
                - name: shared
                  mountPath: /shared
          volumes:
            - name: shared
              emptyDir: {}
