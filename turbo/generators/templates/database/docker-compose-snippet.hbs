  {{ name }}-migrate:
    build:
      context: ../..
      dockerfile: servers/{{ name }}/Dockerfile
      target: migrate
      args:
        BUN_TARGET: ${BUN_TARGET:-bun-linux-arm64}
    container_name: {{ name }}_migrate
    env_file:
      - .env
    networks:
      - adminer
    depends_on:
      {{ name }}-db:
        condition: service_healthy
    restart: "no"

  {{ name }}-db:
    image: postgres:15.3-alpine
    container_name: {{ name }}_db
    environment:
      POSTGRES_USER: myuser
      POSTGRES_PASSWORD: mypassword
      POSTGRES_DB: {{ name }}
    ports:
      - "5101:5432"
    networks:
      - adminer
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U myuser -d {{ name }}" ]
      interval: 5s
      timeout: 5s
      retries: 10
    restart: unless-stopped