\{{- $dbSecret := lookup "v1" "Secret" .Release.Namespace "{{ name }}-db-secret" }}
\{{- $dbPassword := randAlphaNum 32 }}
\{{- if $dbSecret }}
\{{- $dbPassword = index $dbSecret.data "password" | b64dec }}
\{{- else if .Values.dbPassword }}
# Tilt override (see Tiltfile's set=["dbPassword=..."]) — `lookup` above always returns nothing
# under Tilt's own "offline-only" helm() (no live cluster access at all), so without this, every
# single Tiltfile reconcile would mint a *new* random password here while server1-db's own pod
# (fixed at its last boot) and server1-migrate's Job (a literal env value, immutable once
# created) each keep whatever stale value they already had — three different passwords, auth
# failures. A real `helm install`/Terraform never sets this, so it still gets a real random
# password there, correctly reused via `lookup` on every later `helm upgrade`.
\{{- $dbPassword = .Values.dbPassword }}
\{{- end }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ name }}-db
  namespace: \{{ .Values.namespace }}
  labels:
    app: {{ name }}-db
spec:
  # Always 1 — a second replica would each get its own volume and diverge into two separate
  # databases, not a real HA setup. Local/testing Postgres, same scope as every other
  # single-instance infra chart in this repo.
  replicas: 1
  selector:
    matchLabels:
      app: {{ name }}-db
  template:
    metadata:
      labels:
        app: {{ name }}-db
    spec:
      # Postgres's image runs as a non-root uid (999) — matches every other bundled-Postgres
      # chart in this repo (see services/authentik/helm/values.yaml's volumePermissions comment)
      # so the default root-owned volume is actually writable by it.
      securityContext:
        fsGroup: 999
      containers:
        - name: postgres
          image: postgres:15.3-alpine
          ports:
            - name: postgres
              containerPort: 5432
          env:
            - name: POSTGRES_USER
              value: myuser
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-db-secret
                  key: password
            - name: POSTGRES_DB
              value: {{ name }}
          volumeMounts:
            - name: data
              mountPath: /var/lib/postgresql/data
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "myuser", "-d", "{{ name }}"]
            initialDelaySeconds: 5
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: postgres
            initialDelaySeconds: 15
            periodSeconds: 20
      # ponytail: emptyDir, not a PersistentVolumeClaim — this is a per-server dev/test database,
      # losing data on pod restart is fine. Switch to a PVC (see git history's
      # templates/database/helm/postgres-pvc.yaml for the old shape) if that stops being true.
      volumes:
        - name: data
          emptyDir: {}

---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}-db
  namespace: \{{ .Values.namespace }}
  labels:
    app: {{ name }}-db
spec:
  # ClusterIP — only this server's own app pod and the migrate Job need to reach this.
  type: ClusterIP
  selector:
    app: {{ name }}-db
  ports:
    - name: postgres
      port: 5432
      targetPort: postgres

---
# The Postgres superuser's own password — read by the postgres container above and by
# db-provision-job.yaml's vault write database/config/... (admin creds Vault uses to mint leaf
# roles). Randomly generated on first `helm install` (see the `lookup`/`randAlphaNum` block at
# the top of this file) and kept stable across every later `helm upgrade` — `lookup` reads this
# same Secret's already-set password back instead of minting a fresh one on every render, which
# would otherwise silently break Postgres/Vault's already-established credential each upgrade.
# Only works against a real cluster: `helm template`/`--dry-run` always see `lookup` return
# nothing, so those always take the "generate new" branch instead — expected, not a bug.
apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-db-secret
  namespace: \{{ .Values.namespace }}
type: Opaque
data:
  password: \{{ $dbPassword | b64enc }}

---
# Consumed via envFrom by this chart's own deployment.yaml (see wireHelmDeploymentConfigMap) and
# by the migrate Job below. DB_HOST/DB_PORT/DB_NAME only — DATABASE_URL itself lives in
# {{ name }}-secret (below), not here, since it holds Vault-minted credentials rather than a
# static value safe for a ConfigMap.
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ name }}-env
  namespace: \{{ .Values.namespace }}
data:
  DB_HOST: {{ name }}-db
  DB_PORT: "5432"
  DB_NAME: {{ name }}

---
# DATABASE_URL for the app's own Deployment (envFrom secretRef) — starts out pointing at the
# static superuser creds so the app can still boot before db-provision-job.yaml's post-install
# hook has run once; that hook immediately overwrites this key with Vault-minted leaf creds and
# rolls the Deployment. See db-provision-job.yaml for the whole rotation story.
apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-secret
  namespace: \{{ .Values.namespace }}
type: Opaque
stringData:
  DATABASE_URL: postgresql://myuser:\{{ $dbPassword }}@{{ name }}-db:5432/{{ name }}

---
apiVersion: batch/v1
kind: Job
metadata:
  # A Job's spec is immutable — re-running `tilt up`/`helm upgrade` after a real schema change
  # needs this Job deleted first (`kubectl delete job {{ name }}-migrate`), or the apply fails
  # trying to update a field it can't change in place.
  name: {{ name }}-migrate
  namespace: \{{ .Values.namespace }}
  labels:
    app: {{ name }}-migrate
spec:
  # Postgres's own readinessProbe gates whether its Service has any endpoints at all — until it
  # does, connections here just fail outright rather than queueing, so this Job relies on
  # backoffLimit's retries (with backoff) rather than an initContainer wait-loop.
  backoffLimit: 6
  template:
    metadata:
      labels:
        app: {{ name }}-migrate
    spec:
      restartPolicy: OnFailure
      containers:
        - name: migrate
          image: {{ name }}-migrate
          env:
            - name: DATABASE_URL
              value: postgresql://myuser:\{{ $dbPassword }}@{{ name }}-db:5432/{{ name }}
