apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ name }}-kafka-env
data:
  # In-cluster k8s Service names (see services/kafka/helm) — not docker-compose's old
  # localhost:29092 host-mapped port, which only made sense from outside the cluster.
  KAFKA_BROKERS: kafka:9092
  SCHEMA_REGISTRY_URL: http://schema-registry:8081
{{#if includeGroupId}}
  KAFKA_GROUP_ID: {{ name }}-group
{{/if}}
