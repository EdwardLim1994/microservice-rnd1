apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ name }}-graphql-env
  namespace: \{{ .Values.namespace }}
data:
  GRAPHQL_PORT: "{{ port }}"

---
# Stable in-cluster DNS ({{ name }}, or {{ name }}.\{{ .Values.namespace }}.svc.cluster.local
# from another namespace) — for the Apollo Router supergraph's routing_url once this subgraph is
# registered (see appendSupergraphSubgraph), or for manual testing — nothing else in this chart
# provides one.
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}
  namespace: \{{ .Values.namespace }}
spec:
  type: ClusterIP
  selector:
    app: {{ name }}
  ports:
    - name: graphql
      port: {{ port }}
      targetPort: {{ port }}
    # HealthCheckPlugin (packages/server) — every server includes it from scaffold (see
    # templates/server/src/app.ts) and it always listens on 9000, so this port is safe to expose
    # unconditionally rather than gating it behind whether this particular driver uses it.
    - name: healthcheck
      port: 9000
      targetPort: 9000
