\{{- $redisSecret := lookup "v1" "Secret" .Release.Namespace "{{ name }}-redis-admin-secret" }}
\{{- $redisPassword := randAlphaNum 32 }}
\{{- if $redisSecret }}
\{{- $redisPassword = index $redisSecret.data "password" | b64dec }}
\{{- end }}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ name }}-redis
  namespace: \{{ .Values.namespace }}
  labels:
    app: {{ name }}-redis
spec:
  # Always 1 — dev cache, not HA. Same scope as {{ name }}-db.
  replicas: 1
  selector:
    matchLabels:
      app: {{ name }}-redis
  template:
    metadata:
      labels:
        app: {{ name }}-redis
    spec:
      containers:
        - name: redis
          image: redis:7-alpine
          # No REDIS_PASSWORD substitution in `args:` (redis-server doesn't expand env vars in
          # its own argv) — wrapped in sh -c so the shell expands it instead.
          command: ["sh", "-c", "exec redis-server --requirepass \"$REDIS_PASSWORD\""]
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ name }}-redis-admin-secret
                  key: password
          ports:
            - name: redis
              containerPort: 6379
          readinessProbe:
            exec:
              # Same sh -c wrapping as `command` above — a bare exec array can't expand
              # $REDIS_PASSWORD, and an unauthenticated `redis-cli ping` against a
              # requirepass-protected server fails with NOAUTH.
              command: ["sh", "-c", "redis-cli -a \"$REDIS_PASSWORD\" ping"]
            initialDelaySeconds: 5
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: redis
            initialDelaySeconds: 15
            periodSeconds: 20

---
apiVersion: v1
kind: Service
metadata:
  name: {{ name }}-redis
  namespace: \{{ .Values.namespace }}
  labels:
    app: {{ name }}-redis
spec:
  type: ClusterIP
  selector:
    app: {{ name }}-redis
  ports:
    - name: redis
      port: 6379
      targetPort: redis

---
# The Redis "default" superuser's own password — read by the redis container above (requirepass)
# and reused directly below as the app's own REDIS_URL (static, no separate ACL user). Randomly
# generated on first `helm install` and kept stable across every later `helm upgrade` via the
# `lookup`/`randAlphaNum` block at the top of this file — same reasoning as helm-db.yaml.hbs's
# {{ name }}-db-secret. Only works against a real cluster: `helm template`/`--dry-run` always see
# `lookup` return nothing, so those always take the "generate new" branch instead — expected, not
# a bug.
apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-redis-admin-secret
  namespace: \{{ .Values.namespace }}
type: Opaque
data:
  password: \{{ $redisPassword | b64enc }}

---
# REDIS_URL for the app's own Deployment (envFrom secretRef) — the same static admin password
# above, permanently (no separate ACL user, no rotation).
apiVersion: v1
kind: Secret
metadata:
  name: {{ name }}-redis-secret
  namespace: \{{ .Values.namespace }}
type: Opaque
stringData:
  REDIS_URL: redis://default:\{{ $redisPassword }}@{{ name }}-redis:6379
