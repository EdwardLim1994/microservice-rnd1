k8s_yaml(helm("./helm", name="ca-distribution", namespace="infra"))

# fetch-ca's own initContainer (helm/templates/deployment.yaml) only loops on `vault status` —
# vault being reachable, not vault's pki_int engine actually having a default issuer configured.
# `vault read pki/cert/ca` 400s ("no default issuer currently configured") until
# vault-pki-provision has run, and that failure isn't looped, so without this dep the pod
# crash-loops (with growing backoff, up to 5m) until it happens to win the race instead of
# starting only once the issuer is actually ready.
k8s_resource(
    "ca-distribution",
    resource_deps=["vault-pki-provision"],
    labels=["infra"],
)
