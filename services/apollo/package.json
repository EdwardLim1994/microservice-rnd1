	"devDependencies": {
		"@types/bun": "latest",
		"config": "workspace:*"
	},
	"dependencies": {
		"@apollo/rover": "^0.40.0",
		"script": "workspace:*",
		"server": "workspace:*"
	},
	"scripts": {
