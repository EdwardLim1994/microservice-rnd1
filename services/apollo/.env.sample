APOLLO_ROUTER_CONFIG_PATH=/etc/router.yaml
APOLLO_ROUTER_SUPERGRAPH_PATH=/etc/supergraph.graphql
APOLLO_ROUTER_HOT_RELOAD="true"
APOLLO_ROUTER_CHECK="true"

# TLS (mTLS to every subgraph — see packages/server/CLAUDE.md's TLS section and
# services/vault/CLAUDE.md's PKI section). VAULT_ROLE_ID/VAULT_SECRET_ID are filled in by
# `bun run vault:provision` (mirrors each server's own script), never committed here.
VAULT_ADDR=http://localhost:8200
VAULT_TLS_ROLE=apollo-router-tls-role
