k8s_yaml(helm("./helm", name="authentik", namespace="infra"))

# The upstream authentik chart renders two Deployments — authentik-server and authentik-worker —
# not a single "authentik" workload, so k8s_resource("authentik", ...) has nothing to attach to
# ("unknown resource"). Configure both separately instead of merging into one resource: they're
# genuinely independent pods with their own logs/restarts, not one workload split in two.
k8s_resource("authentik-server", labels=["infra"])
k8s_resource("authentik-worker", labels=["infra"])
