AUTHENTIK_SECRET_KEY=changeme-generate-a-real-secret-key
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASSWORD=authentikpassword
AUTHENTIK_PG_DB=authentik
AUTHENTIK_BOOTSTRAP_EMAIL=admin@localhost
AUTHENTIK_BOOTSTRAP_PASSWORD=adminpassword
# Mints a ready-made akadmin API token at boot (no login step needed) — generate via
# `openssl rand -hex 32`. Consumed by services/authentik/ansible's provisioning role.
AUTHENTIK_BOOTSTRAP_TOKEN=
