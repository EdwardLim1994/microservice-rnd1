# helm/templates/secret.yaml generates a random root token once and reuses it via `lookup` on
# every later `helm upgrade` — but Tilt's own helm() is "offline-only" templating (no live
# cluster access at all, see Tilt's own helm.md docs), so `lookup` always returns nothing here,
# every single reconcile, not just the first. Vault's own pod only ever reads vault-secret once,
# at its own first boot, and never restarts to pick up a new value — but every freshly-created
# provisioning-job pod reads whatever's *currently* in the Secret. Since Tilt keeps regenerating
# a brand-new random token on every reconcile, that's a fresh mismatch ("invalid token") on
# almost every single provisioning attempt.
#
# Fix: force a token that's stable across every Tilt render, without touching the chart's own
# real (Terraform-facing) `lookup`-based behavior. secret.yaml only random-generates when
# .Values.rootToken is still literally "vaultroottoken" (its values.yaml default) — passing any
# other literal here short-circuits both the lookup branch (always empty anyway) and the
# random-generate branch, so this exact value gets used deterministically on every render.
# Local-dev-only value, never used for a real deploy (Terraform never sets this override).
#
# statefulset.yaml's hostAliases (authentik.lan → Traefik's ClusterIP, needed for
# `vault write auth/oidc/config` to validate Authentik's discovery URL from inside vault-0
# itself) hits the exact same "lookup always returns nothing under Tilt" problem — read the real,
# already-live ClusterIP ourselves (services/Tiltfile's own traefik bootstrap already guarantees
# it exists by the time this file is included) and pass it straight through instead.
traefik_cluster_ip = str(local(
    "kubectl get svc traefik-web-8080 -n infra -o jsonpath='{.spec.clusterIP}'",
    quiet=True,
)).strip()

k8s_yaml(helm(
    "./helm",
    name="vault",
    namespace="infra",
    set=[
        "rootToken=tilt-local-dev-vault-token",
        "traefikClusterIp=" + traefik_cluster_ip,
    ],
))
k8s_resource("vault", labels=["infra"])

# vault-db-provision (`kubectl rollout status deployment/authentik-server`, no retry loop of its
# own — see that Job's own header comment) and vault-oidc-provision (a 15min wget retry loop
# against authentik-server, but no reason to make it burn through that) both roll/poll
# authentik-server + authentik-worker, which live in a wholly separate Tiltfile/Helm release
# (services/authentik) with no ordering against this one otherwise — Tilt applies independent
# k8s_yaml resources with no guaranteed relative order unless resource_deps says so. Without
# this, vault-db-provision can hit "deployments.apps authentik-server not found" before
# authentik's chart has even applied, exhaust its Job backoffLimit, and need a manual re-trigger.
# Forward-referencing a not-yet-included Tiltfile's resource names is fine — see
# services/Tiltfile's own "services-ready" comment for why.
k8s_resource(
    "vault-db-provision",
    resource_deps=["vault", "authentik-server", "authentik-worker"],
    labels=["infra"],
)
k8s_resource(
    "vault-oidc-provision",
    resource_deps=["vault", "authentik-server", "authentik-worker"],
    labels=["infra"],
)
